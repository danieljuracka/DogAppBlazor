@* Výber profilovej fotky psa. Fotka sa hneď po výbere zmenší, nahrá a do Value sa vloží jej názov. Podporuje @bind-Value. *@

<div class="dog-photo-picker">
	<div class="form-label">@Label</div>
	<div class="d-flex flex-wrap align-items-center gap-3">
		<DogAvatar Name="@DogName" Color="@DogColor" PhotoUrl="@NavigationRoutes.PetPhotos.GetPhoto(Value)" Size="72" />

		<div class="d-flex flex-wrap gap-2">
			<label class="@GetUploadButtonCssClass()">
				@if (IsUploading)
				{
					<HxSpinner Size="SpinnerSize.Small" Color="ThemeColor.None" />
					<span>Nahrávam…</span>
				}
				else
				{
					<HxIcon Icon="@BootstrapIcon.Camera" />
					<span>@(String.IsNullOrEmpty(Value) ? "Nahrať fotku" : "Zmeniť fotku")</span>
				}
				<InputFile OnChange="HandleFileSelectedAsync" accept="image/*" disabled="@IsUploading" class="visually-hidden" />
			</label>

			@if (!String.IsNullOrEmpty(Value))
			{
				<HxButton Text="Odstrániť"
						  Icon="@BootstrapIcon.Trash"
						  Color="ThemeColor.Secondary"
						  Outline="true"
						  Enabled="!IsUploading"
						  OnClick="RemoveAsync" />
			}
		</div>
	</div>
</div>
